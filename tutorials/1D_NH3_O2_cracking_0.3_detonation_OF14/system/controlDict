FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}

// foamRun loads libdetonationFluidSolver.so from this entry.
solver          detonationFluid;

startFrom       startTime;
startTime       0;
stopAt          endTime;
endTime         300e-6;

deltaT          1e-11;

writeControl    adjustableRunTime;
writeInterval   1e-7;
purgeWrite      0;
writeFormat     ascii;
writePrecision  12;
writeCompression off;
timeFormat      general;
timePrecision   12;
runTimeModifiable true;

adjustTimeStep  yes;
maxCo           0.1;
maxDeltaT       1e-6;

functions
{
}

