#!/usr/bin/env bash
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$ROOT"

[[ "$(cat VERSION)" == "1.0.0" ]] || { echo "ERROR: VERSION is not 1.0.0" >&2; exit 2; }
[[ -f RELEASE_FILE_SHA256SUMS ]] || { echo "ERROR: RELEASE_FILE_SHA256SUMS missing" >&2; exit 2; }
sha256sum -c RELEASE_FILE_SHA256SUMS >/dev/null

echo "PASS: v1.0.0 frozen-file checksums"

for f in \
  docs/detonationFoam_OF14_Manual.md \
  docs/detonationFoam_OF14_Manual.docx \
  docs/detonationFoam_OF14_Manual.pdf \
  docs/planarRefiner_OF14_Manual.md \
  docs/planarRefiner_OF14_Manual.docx \
  docs/planarRefiner_OF14_Manual.pdf; do
  [[ -s "$f" ]] || { echo "ERROR: missing manual: $f" >&2; exit 3; }
done

grep -q 'OF8' docs/detonationFoam_OF14_Manual.md
grep -q 'migration' docs/detonationFoam_OF14_Manual.md
grep -q 'capability' docs/detonationFoam_OF14_Manual.md
grep -q 'planarRefiner' docs/detonationFoam_OF14_Manual.md
grep -q 'fvMeshTopoChanger' docs/planarRefiner_OF14_Manual.md
grep -q './AllwmakeAMR' docs/planarRefiner_OF14_Manual.md
grep -q 'Version 1.0.0 - September 2026' docs/detonationFoam_OF14_Manual.md
grep -q 'Version 1.0.0 - September 2026' docs/planarRefiner_OF14_Manual.md

# Word styles must retain the monospaced inline/code style requested for OpenFOAM text.
for f in docs/*.docx; do
  unzip -p "$f" word/styles.xml | grep -q 'Liberation Mono' || {
    echo "ERROR: monospaced Word code style not found in $f" >&2; exit 4;
  }
done

echo "PASS: six final manuals, OF8 migration, AMR documentation, GitHub Markdown, and monospaced Word code styles"

[[ -x Allwmake && -x AllwmakeAMR && -x Allwclean && -x AllwcleanAMR ]]
[[ -x src/planarFvMeshTopoChangers/Allwmake ]]
if grep -Rqi 'detonationFluid' src/planarFvMeshTopoChangers/planarRefiner src/planarFvMeshTopoChangers/Make; then
  echo "ERROR: reusable planar AMR production source contains detonation-specific dependency" >&2
  exit 5
fi

echo "PASS: standalone planarRefiner source/build path is solver-independent"

grep -q 'Final release status: PASSED / RELEASED' QUALIFICATION_SUMMARY.md
grep -q 'R1 PASSED' qualification/R1_RETURNED_RESULT_ASSESSMENT.md
grep -q 'Gate F3 status - PASSED' qualification/GATE_F3_STATUS.md

echo "PASS: authoritative qualification summary closes F3, G1-G4, and R1"

bash -n VerifyRelease
bash -n RunReleaseQualification
bash -n Allwmake
bash -n AllwmakeAMR
bash -n Allwclean
bash -n AllwcleanAMR

echo "PASS: release shell syntax"
echo "OpenFOAM 14 detonationFoam v1.0.0 release verification: PASSED"
