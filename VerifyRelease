#!/usr/bin/env bash
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$ROOT"

[[ "$(cat VERSION)" == "1.1.0" ]] || { echo "ERROR: VERSION is not 1.1.0" >&2; exit 2; }
[[ -f RELEASE_FILE_SHA256SUMS ]] || { echo "ERROR: RELEASE_FILE_SHA256SUMS missing" >&2; exit 2; }
sha256sum -c RELEASE_FILE_SHA256SUMS >/dev/null

echo "PASS: v1.1.0 frozen-file checksums"

for f in \
  docs/detonationFoam_OF14_Manual.md \
  docs/detonationFoam_OF14_Manual.docx \
  docs/detonationFoam_OF14_Manual.pdf \
  docs/planarRefiner_OF14_Manual.md \
  docs/planarRefiner_OF14_Manual.docx \
  docs/planarRefiner_OF14_Manual.pdf; do
  [[ -s "$f" ]] || { echo "ERROR: missing manual: $f" >&2; exit 3; }
done

grep -q 'Version 1.1.0 - September 2026' docs/detonationFoam_OF14_Manual.md
grep -q 'Version 1.1.0 - September 2026' docs/planarRefiner_OF14_Manual.md
grep -q 'automaticUnrefinement' docs/detonationFoam_OF14_Manual.md
grep -q 'publishedOF8' docs/detonationFoam_OF14_Manual.md
grep -q 'Reversible split tree' docs/planarRefiner_OF14_Manual.md
grep -q 'maxUnrefinementPassesPerUpdate' docs/planarRefiner_OF14_Manual.md
grep -q 'OF8 to OF14 capability disposition' docs/detonationFoam_OF14_Manual.md

# Word styles retain the monospaced code style requested for OpenFOAM text.
for f in docs/*.docx; do
  unzip -p "$f" word/styles.xml | grep -q 'Liberation Mono' || {
    echo "ERROR: monospaced Word code style not found in $f" >&2; exit 4;
  }
done

echo "PASS: six v1.1.0 manuals, migration, Soret, automatic-unrefinement, and monospaced Word styles"

[[ -x Allwmake && -x AllwmakeAMR && -x Allwclean && -x AllwcleanAMR ]]
[[ -x src/planarFvMeshTopoChangers/Allwmake ]]
if grep -Rqi 'detonationFluid' src/planarFvMeshTopoChangers/planarRefiner src/planarFvMeshTopoChangers/Make; then
  echo "ERROR: reusable planar AMR production source contains detonation-specific dependency" >&2
  exit 5
fi

echo "PASS: standalone planarRefiner source/build path is solver-independent"

# Re-run the accepted production/static feature audit.
python3 qualification/candidate1/VerifyAutoUnrefSoretSource.py >/dev/null

echo "PASS: automatic-unrefinement + publishedOF8 Soret production/static audit"

# New integrated laptop tutorial packaging.
TUT=tutorials/H2_O2_laptop_autoUnref_Soret_OF14
for f in Allrun Allclean AnalyzeLaptopSmoke.py VerifyIgnition.py VerifyLaptopSmoke \
         constant/dynamicMeshDict constant/thermophysicalTransport constant/thermoDiff \
         system/setFieldsDict; do
  [[ -s "$TUT/$f" ]] || { echo "ERROR: missing v1.1.0 laptop-smoke file: $TUT/$f" >&2; exit 6; }
done
grep -q 'automaticUnrefinement[[:space:]]*true' "$TUT/constant/dynamicMeshDict"
grep -q 'legacyThermalDiffusionMode[[:space:]]*publishedOF8' "$TUT/constant/thermophysicalTransport"
grep -q 'synthetic diagnostic' "$TUT/README.md"
python3 -m py_compile "$TUT/AnalyzeLaptopSmoke.py" "$TUT/VerifyIgnition.py"

echo "PASS: 120-cell integrated H2/O2 laptop tutorial packaged with initialization guard"

grep -q 'Final release status: PASSED / RELEASED' QUALIFICATION_SUMMARY.md
grep -q 'v1.1-U' QUALIFICATION_SUMMARY.md
grep -q 'v1.1-S' QUALIFICATION_SUMMARY.md
grep -q 'v1.1-I' QUALIFICATION_SUMMARY.md
grep -q 'Status: \*\*PASSED' qualification/V1_1_AUTO_UNREF_SORET_QUALIFICATION.md
grep -q 'Status: \*\*PASSED' qualification/INTEGRATED_H2_LAPTOP_SMOKE.md

echo "PASS: authoritative v1.1.0 qualification summary and feature closure records"

bash -n VerifyRelease
bash -n RunReleaseQualification
bash -n Allwmake
bash -n AllwmakeAMR
bash -n Allwclean
bash -n AllwcleanAMR
bash -n "$TUT/Allrun"
bash -n "$TUT/Allclean"

echo "PASS: release shell syntax"
echo "OpenFOAM 14 detonationFoam v1.1.0 release verification: PASSED"
